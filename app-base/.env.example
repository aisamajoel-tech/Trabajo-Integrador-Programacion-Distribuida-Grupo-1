# Configuración del Servidor HTTP / HTTPS
PORT_HTTP=3000
PORT_HTTPS=3443

# Rutas de Certificados SSL/TLS (Generados localmente)
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.cert

# Base de Datos MongoDB (Mongoose)
MONGODB_URI=mongodb://127.0.0.1:27017/biblioteca_db

# Configuración de Redis / Memurai
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Configuración de Concurrencia y Distributed Lock
LOCK_TTL_MS=5000
ARTIFICIAL_DELAY_MS=1500

# Configuración de Logging con Winston
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
