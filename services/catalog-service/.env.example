# ============================================================================
# CONFIGURACIÓN DE ENTORNO — catalog-service
# Copiar este archivo a .env para ejecución local: cp .env.example .env
# ============================================================================

# Identificador del microservicio (usado en logs y /health)
SERVICE_NAME=catalog-service

# Puerto de escucha del servidor HTTP
# - Ejecución local: 3001
# - Ejecución en contenedor Docker: 3000 (publicado al host como 3001:3000)
PORT=3001

# URI de conexión a la base de datos propia de catálogo (MongoDB)
# - Ejecución local: mongodb://127.0.0.1:27017/db_catalog
# - Docker Compose:  mongodb://catalog-db:27017/db_catalog
MONGODB_URI=mongodb://127.0.0.1:27017/db_catalog

# Nivel de detalle de logs (debug | info | warn | error)
LOG_LEVEL=info

# Intervalo de reintento de conexión a MongoDB en milisegundos
DB_RETRY_INTERVAL_MS=5000
