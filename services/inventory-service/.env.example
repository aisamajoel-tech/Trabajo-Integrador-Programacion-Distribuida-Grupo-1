# ============================================================================
# CONFIGURACIÓN DE ENTORNO — inventory-service
# Copiar este archivo a .env para ejecución local: cp .env.example .env
# El código es el mismo en local y en Docker Compose: solo cambian estas variables.
# ============================================================================

# Identificador del microservicio (usado en logs y /health)
SERVICE_NAME=inventory-service

# Puerto de escucha del servidor HTTP
# - Ejecución local: 3002
# - Docker Compose:  3000 (publicado al host como 3002:3000)
PORT=3002

# Base de datos propia de inventario (MongoDB)
# - Ejecución local: mongodb://127.0.0.1:27017/db_inventory
# - Docker Compose:  mongodb://inventory-db:27017/db_inventory
MONGODB_URI=mongodb://127.0.0.1:27017/db_inventory

# Redis / Memurai para el lock distribuido (reemplaza REDIS_HOST + REDIS_PORT del monolito)
# - Ejecución local: redis://127.0.0.1:6379
# - Docker Compose:  redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Tiempo de vida del lock en milisegundos (evita bloqueos eternos si el proceso cae)
LOCK_TTL_MS=5000

# Reintentos para tomar un lock ocupado antes de responder 409, y espera base entre intentos (ms)
LOCK_REINTENTOS=3
LOCK_ESPERA_MS=50

# Retardo artificial dentro de la sección crítica, SOLO para demostraciones de concurrencia.
# Dejar en 0 en uso normal.
ARTIFICIAL_DELAY_MS=0

# Nivel de detalle de logs (debug | info | warn | error)
LOG_LEVEL=info

# Intervalo de reintento de conexión a MongoDB (ms)
DB_RETRY_INTERVAL_MS=5000

# (Opcional) Si se define, el alta de stock verifica que el libro exista en catalog-service.
# Si se deja vacía, la verificación se omite.
# - Ejecución local: http://localhost:3001
# - Docker Compose:  http://catalog-service:3000
CATALOG_SERVICE_URL=
HTTP_TIMEOUT_MS=3000
