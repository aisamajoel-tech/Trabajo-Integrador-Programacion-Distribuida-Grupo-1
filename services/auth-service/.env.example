# ============================================================================
# CONFIGURACIÓN DE ENTORNO — auth-service (TP7 - Grupo 1)
# Copiar este archivo a .env para ejecución local: cp .env.example .env
# Nunca versionar secretos reales en Git.
# ============================================================================

# Identificador del microservicio (usado en logs y /health)
SERVICE_NAME=auth-service

# Puerto de escucha del servidor HTTP
# - Ejecución local: 3004
# - Docker Compose:  3000 (publicado al host como 3004:3000)
PORT=3004

# Base de datos propia de identidad y credenciales (MongoDB)
# - Ejecución local: mongodb://127.0.0.1:27017/db_auth
# - Docker Compose:  mongodb://auth-db:27017/db_auth
MONGODB_URI=mongodb://127.0.0.1:27017/db_auth

# Configuración de firma y emisión de JWT (algoritmo HS256)
JWT_SECRET=dev_jwt_secret_grupo1_cambiar_en_entorno_real_2026
JWT_EXPIRES_IN=1h
JWT_ISSUER=auth-service-grupo1

# Factor de costo (rounds) para el hash de contraseñas con bcrypt
BCRYPT_ROUNDS=10

# Credenciales ficticias de desarrollo para bootstrap del usuario ADMIN inicial
ADMIN_EMAIL=admin@libreria.com
ADMIN_PASSWORD=Admin1234!
ADMIN_NOMBRE=Administrador Librería

# Nivel de detalle de logs (debug | info | warn | error)
LOG_LEVEL=info

# Intervalo de reintento de conexión a MongoDB (ms)
DB_RETRY_INTERVAL_MS=5000
