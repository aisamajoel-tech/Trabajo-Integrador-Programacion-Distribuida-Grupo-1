# ============================================================================
# CONFIGURACIÓN DE ENTORNO — orders-service
# Copiar este archivo a .env para ejecución local: cp .env.example .env
# El código es el mismo en local y en Docker Compose: solo cambian estas variables.
# ============================================================================

# Identificador del microservicio (usado en logs y /health)
SERVICE_NAME=orders-service

# Puerto de escucha del servidor HTTP
# - Ejecución local: 3003
# - Docker Compose:  3000 (publicado al host como 3003:3000)
PORT=3003

# Base de datos propia de órdenes (MongoDB)
# - Ejecución local: mongodb://127.0.0.1:27017/db_orders
# - Docker Compose:  mongodb://orders-db:27017/db_orders
MONGODB_URI=mongodb://127.0.0.1:27017/db_orders

# URLs de los servicios que consume (nunca hardcodeadas en el código)
# - Ejecución local: http://localhost:3001 y http://localhost:3002
# - Docker Compose:  http://catalog-service:3000 y http://inventory-service:3000
CATALOG_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002

# Tiempo máximo de espera de cada llamada a otro servicio (ms). Pasado ese tiempo -> 503
HTTP_TIMEOUT_MS=3000

# Cada cuánto se reintentan las compensaciones pendientes (ms)
COMPENSACION_INTERVALO_MS=30000

# Nivel de detalle de logs (debug | info | warn | error)
LOG_LEVEL=info

# Intervalo de reintento de conexión a MongoDB (ms)
DB_RETRY_INTERVAL_MS=5000
