# ============================================================================
# CONFIGURACIÓN DE ENTORNO — DOCKER COMPOSE (TP6) Y APLICACIÓN BASE (TP5)
# Copiar este archivo a .env en la raíz si se desean personalizar variables:
#   cp .env.example .env
# ============================================================================

# --- Puertos publicados en el host por Docker Compose (TP6) ---
CATALOG_HOST_PORT=3001
INVENTORY_HOST_PORT=3002
ORDERS_HOST_PORT=3003

# --- Parámetros transversales de microservicios (TP6) ---
LOCK_TTL_MS=5000
HTTP_TIMEOUT_MS=3000
LOG_LEVEL=info

# --- Configuración heredada de app-base (TP5 / Monolito de referencia) ---
PORT=3000
HTTPS_PORT=3443
MONGO_URI=mongodb://localhost:27017/biblioteca_distribuida
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ARTIFICIAL_DELAY_MS=1500
