# ============================================================================
# CONFIGURACIÓN DE ENTORNO — DOCKER COMPOSE (TP6/TP7) Y APLICACIÓN BASE (TP5)
# Copiar este archivo a .env en la raíz si se desean personalizar variables:
#   cp .env.example .env
# ============================================================================

# --- Puertos publicados en el host por Docker Compose (TP6) ---
CATALOG_HOST_PORT=3001
INVENTORY_HOST_PORT=3002
ORDERS_HOST_PORT=3003
AUTH_HOST_PORT=3004

# --- Parámetros transversales de microservicios (TP6) ---
LOCK_TTL_MS=5000
HTTP_TIMEOUT_MS=3000
LOG_LEVEL=info

# --- Seguridad (TP7) — JWT compartido por los 4 servicios ---
# auth-service firma los tokens; catalog, inventory y orders los validan con el mismo secreto.
# Valores de ejemplo SOLO para desarrollo: en un entorno real usar un secreto largo y aleatorio.
JWT_SECRET=dev_jwt_secret_grupo1_cambiar_en_entorno_real_2026
JWT_ISSUER=auth-service-grupo1
# 1h por defecto. Para probar el token vencido (Escenario G) se puede usar, por ejemplo, 10s.
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Usuario ADMIN inicial que auth-service crea al arrancar (solo desarrollo)
ADMIN_EMAIL=admin@libreria.com
ADMIN_PASSWORD=Admin1234!
ADMIN_NOMBRE=Administrador Librería

# --- Configuración heredada de app-base (TP5 / Monolito de referencia) ---
PORT=3000
HTTPS_PORT=3443
MONGO_URI=mongodb://localhost:27017/biblioteca_distribuida
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ARTIFICIAL_DELAY_MS=1500
