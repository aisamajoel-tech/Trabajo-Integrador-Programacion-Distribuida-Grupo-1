# ==========================================
# CONFIGURACIÓN DE ENTORNO - APLICACIÓN BASE
# ==========================================

# Puerto de la API REST (HTTP)
PORT=3000

# Puerto HTTPS
HTTPS_PORT=3443

# Base de Datos MongoDB
MONGO_URI=mongodb://localhost:27017/biblioteca_distribuida

# Coordinador de Concurrencia y Locks (Redis / Memurai)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Parámetros de Concurrencia y Simulación
ARTIFICIAL_DELAY_MS=1500
LOCK_TTL_MS=5000

# Nivel de Logs (info, warn, error, debug)
LOG_LEVEL=info
